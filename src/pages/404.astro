---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="wrap grid-12 min-h-[70svh] content-end gap-y-6 pt-[140px] pb-20">
    <p class="meta col-span-4 text-muted md:col-span-6">404</p>
    <div class="col-span-4 md:col-span-6">
      <h1 class="statement">This page does not exist.</h1>
      <p class="mt-6 text-[16px]">It may have moved when the site was rebuilt.</p>
      <a href="/" class="more mt-8"><span>Back to home</span></a>
    </div>
  </section>
</BaseLayout>
