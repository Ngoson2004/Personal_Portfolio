---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const d = entry.data;
---

<a href={`/work/${entry.id}`} class="group block">
  <div class="overflow-hidden bg-surface" data-card-image>
    {
      d.cover && (
        <Image
          src={d.cover}
          alt=""
          widths={[400, 700, 1000]}
          sizes="(min-width: 768px) 25vw, 50vw"
          class="w-full transition-transform duration-[1.2s] ease-[var(--ease-out-quint)] group-hover:scale-[1.04]"
        />
      )
    }
  </div>
  <div class="mt-4 grid gap-2" data-card-body>
    <h2 class="subtitle group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{d.title}</h2>
    <p class="max-w-[46ch] text-[17px] text-muted">{d.summary}</p>
    <p class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-2">
      {d.tag && <span class="tag">{d.tag}</span>}
      {d.metric && <span class="font-display text-[22px] font-bold tracking-[-0.03em] text-accent">{d.metric.value}</span>}
    </p>
  </div>
</a>
