---
import { nav, site } from "@/data/site";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";

interface Props {
  showNotes: boolean;
}
const { showNotes } = Astro.props;
const items = nav.filter((item) => showNotes || item.href !== "/blog");
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
---

<!--
  Logo and nav switch between ink and paper by what is behind them: sections mark
  themselves data-tone="dark" or "light", and the script below picks the topmost one
  under the header line. (A difference blend would turn the name pink over Forest.)
  The pills sit on a second fixed layer with their own fills.
-->
<header data-header>
  <div class="header-ink pointer-events-none fixed inset-x-0 top-0 z-40">
    <div class="wrap flex h-[68px] items-center gap-10 lg:gap-[13.5vw]">
      <Logo class="pointer-events-auto" />
      <nav aria-label="Primary" class="hidden transition-opacity duration-500 md:block" data-nav>
        <ul class="flex items-center gap-4 text-[16px]">
          {
            items.map((item, i) => (
              <li>
                <a
                  style={`--i:${i}`}
                  href={item.href}
                  class="pointer-events-auto link-underline aria-[current=page]:underline aria-[current=page]:underline-offset-4"
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="header-pills pointer-events-none fixed inset-x-0 top-0 z-40">
    <div class="wrap flex h-[68px] items-center justify-end">
    <div class="pointer-events-auto flex items-center gap-1.5">
      <a href="/contact" class="pill bg-accent text-accent-fg hover:opacity-90" aria-current={isCurrent("/contact") ? "page" : undefined}>Contact</a>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full bg-bg text-fg transition-colors hover:bg-surface"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="menu"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 16 10" class="w-4" aria-hidden="true"><path d="M0 1h16M0 9h16" stroke="currentColor" stroke-width="1.4" /></svg>
      </button>
    </div>
    </div>
  </div>
</header>

<!-- Full-screen menu on the dark band colours. -->
<dialog id="menu" data-lenis-prevent class="m-0 h-dvh max-h-none w-screen max-w-none bg-band text-band-fg backdrop:bg-transparent">
  <div class="wrap flex h-full flex-col pb-6">
    <div class="flex h-[68px] items-center justify-between">
      <Logo />
      <button type="button" class="pill bg-band-fg text-band" data-menu-close>Close</button>
    </div>
    <div class="grid-12 mt-10 flex-1 content-start gap-y-12">
      <nav aria-label="Menu" class="col-span-4 md:col-span-6 md:col-start-7">
        <ul class="grid">
          {
            [...items, { label: "Contact", href: "/contact" }, { label: "Resume", href: site.resume }].map((item, i) => (
              <li class="border-b border-band-line" style={`--i:${i}`}>
                <a href={item.href} class="font-display block py-2 text-[clamp(2.4rem,5vw,4.5rem)] font-semibold leading-none tracking-[-0.035em] text-band-fg transition-colors md:text-band-muted md:hover:text-band-fg">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="grid-12 items-end gap-y-6 text-[16px]">
      <div class="col-span-2 md:col-span-3">
        <p class="meta text-band-muted">Contact</p>
        <a href={`mailto:${site.email}`} class="mt-3 block link-underline w-fit">{site.email}</a>
        <p>{site.location}</p>
      </div>
      <div class="col-span-2 md:col-span-3">
        <p class="meta text-band-muted">Elsewhere</p>
        <a href={site.links.linkedin} class="mt-3 block w-fit link-underline">LinkedIn</a>
        <a href={site.links.github} class="block w-fit link-underline">GitHub</a>
      </div>
      <div class="col-span-4 md:col-span-6 md:text-right">
        <p class="meta text-band-muted">Theme</p>
        <div class="mt-3"><ThemeToggle /></div>
      </div>
    </div>
  </div>
</dialog>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#menu");
  document.querySelector("[data-menu-open]")?.addEventListener("click", () => menu?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => menu?.close());
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) menu.close();
  });

  // Header ink: paper over dark sections and photos, ink over the page.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const tones = [...document.querySelectorAll<HTMLElement>("[data-tone]")];
  if (header && tones.length) {
    const live = new Set<Element>();
    const apply = () => {
      // The last section in document order wins: it is nested inside or stacked over the others.
      let top: Element | null = null;
      for (const el of live) if (!top || top.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) top = el;
      header.toggleAttribute("data-on-dark", (top as HTMLElement | null)?.dataset.tone === "dark");
    };
    let io: IntersectionObserver | undefined;
    const observe = () => {
      io?.disconnect();
      live.clear();
      // A one-pixel line through the middle of the header bar.
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) (e.isIntersecting ? live.add(e.target) : live.delete(e.target));
          apply();
        },
        { rootMargin: `-34px 0px -${Math.max(0, innerHeight - 35)}px 0px` },
      );
      tones.forEach((t) => io!.observe(t));
    };
    observe();
    addEventListener("resize", observe);
    // Pinned sections can change tone without moving (see scripts/scroll.ts).
    addEventListener("tone-change", apply);
  }

  // Like PDA, the nav links slide up out of their masks once you start reading; the menu button stays.
  if (header) {
    const update = () => header.toggleAttribute("data-collapsed", scrollY > 100);
    addEventListener("scroll", update, { passive: true });
    update();

    // At the footer the whole bar slides away.
    const footer = document.querySelector("footer");
    if (footer) {
      new IntersectionObserver(([e]) => header.toggleAttribute("data-hidden", e.isIntersecting), {
        rootMargin: "0px 0px -60% 0px",
      }).observe(footer);
    }
  }
</script>
