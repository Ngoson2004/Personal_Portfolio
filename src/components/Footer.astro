---
import { nav, site } from "@/data/site";
import ThemeToggle from "./ThemeToggle.astro";
import Peaks from "./Peaks.astro";

const year = new Date().getFullYear();
---

<footer data-tone="dark" class="relative overflow-hidden bg-band text-band-fg">
  <div class="footer-inner wrap pt-8">
    <div class="grid-12 gap-y-8 border-b border-band-line pb-8">
      <p aria-hidden="true" class="font-display col-span-4 flex items-end gap-[0.14em] whitespace-nowrap text-[clamp(3.5rem,8vw,8rem)] font-bold leading-[0.82] tracking-[-0.06em] md:col-span-6">
        <span>{site.name}</span>
        <Peaks scroll class="mb-[0.04em] h-[0.66em] w-auto text-band-accent" />
      </p>
      <a href="/contact" class="group col-span-4 flex items-end gap-4 md:col-span-6">
        <span class="font-display text-[clamp(1.8rem,3vw,2.75rem)] font-semibold leading-[1] tracking-[-0.035em]">
          A research idea, a project?<br />Let's talk about it!
        </span>
        <span aria-hidden="true" class="mb-1 grid size-9 shrink-0 place-items-center rounded-full bg-band-line transition-transform duration-500 group-hover:rotate-45">
          <svg viewBox="0 0 10 10" class="w-2.5"><path d="M1 9 9 1M3 1h6v6" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
        </span>
      </a>
    </div>

    <div class="grid-12 gap-y-10 pt-8 pb-24 text-[16px] md:pb-40">
      <div class="col-span-2 md:col-span-3">
        <p class="meta text-band-muted">Contact</p>
        <p class="mt-12">{site.location}</p>
        <a href={`mailto:${site.email}`} class="mt-4 block w-fit link-underline">{site.email}</a>
      </div>
      <nav aria-label="Footer" class="col-span-2 md:col-span-3">
        <p class="meta text-band-muted">Navigation</p>
        <ul class="font-display mt-12 grid text-[22px] leading-[1.25] tracking-[-0.022em]">
          {nav.map((item) => <li><a href={item.href} class="link-underline">{item.label}</a></li>)}
          <li><a href="/contact" class="link-underline">Contact</a></li>
        </ul>
      </nav>
      <div class="col-span-2 md:col-span-3">
        <p class="meta text-band-muted">Elsewhere</p>
        <ul class="mt-12 grid gap-0.5">
          <li><a href={site.links.linkedin} class="link-underline">LinkedIn</a></li>
          <li><a href={site.links.github} class="link-underline">GitHub</a></li>
          <li><a href="/rss.xml" class="link-underline">RSS</a></li>
        </ul>
      </div>
      <div class="col-span-2 md:col-span-3">
        <p class="meta text-band-muted">Resume</p>
        <p class="mt-12 max-w-[30ch]">Experience, research and awards in one PDF.</p>
        <a href={site.resume} class="mt-4 flex h-11 items-center justify-between bg-band-line px-4 transition-colors hover:bg-band-fg hover:text-band">
          <span>Download PDF</span>
          <svg aria-hidden="true" viewBox="0 0 10 12" class="w-2.5"><path d="M5 0v10M1 6l4 4 4-4M0 11.5h10" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
        </a>
      </div>
    </div>

    <div class="grid-12 gap-y-2 pb-5 text-[16px]">
      <p class="col-span-2 md:col-span-3">&copy; {year} {site.name}</p>
      <p class="col-span-2 md:col-span-3">Built with Astro</p>
      <div class="col-span-4 md:col-span-6 md:text-right"><ThemeToggle /></div>
    </div>
  </div>
  <div aria-hidden="true" class="footer-dim pointer-events-none absolute inset-0 bg-scrim"></div>
</footer>
