---
import { Image } from "astro:assets";
import { site } from "@/data/site";
import { research } from "@/data/profile";
import { photos } from "@/data/photos";

const portrait = photos.heroPortrait;
const facts = [
  { label: "Role", value: "Applied AI Scientist, Starbound Space Solutions" },
  { label: "Research", value: "PhD, Monash University, National Industry PhD Program" },
  { label: "Focus", value: "Generative AI for regulatory compliance" },
];
---

<section aria-label="Introduction" data-tone="light" class="relative z-10 bg-bg" data-statement>
  <div class="wrap pt-5 pb-28 md:pb-44" data-statement-inner>
    <p class="statement reveal">{site.statement}</p>

    <!-- Pictures sit in their own grid column, shown whole and filling it.
         The text column carries a title and fact rows so it balances the photo. -->
    <div class="grid-12 mt-20 items-start gap-y-10 md:mt-28">
      <Image
        src={portrait.src}
        alt={portrait.alt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="reveal col-span-4 w-full md:col-span-6"
      />
      <div class="reveal col-span-4 grid content-start gap-8 md:col-span-6">
        <div>
          <h2 class="title">{site.role} and PhD researcher</h2>
          <p class="meta mt-3 text-muted">{site.location}</p>
        </div>
        <dl class="grid border-t border-line">
          {
            facts.map((f) => (
              <div class="grid grid-cols-6 gap-4 border-b border-line py-3">
                <dt class="meta col-span-2 pt-1 text-muted">{f.label}</dt>
                <dd class="col-span-4 text-[18px]">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="grid max-w-[46ch] gap-4 text-[19px] leading-[1.5]">
          <p>{research.summary}</p>
          <p>{site.intro}</p>
        </div>
        <a href="/about" class="more"><span>Discover more about me</span></a>
      </div>
    </div>
  </div>

</section>
