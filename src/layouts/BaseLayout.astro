---
import "@/styles/global.css";
import { site } from "@/data/site";
import { getNotes } from "@/lib/notes";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Peaks from "@/components/Peaks.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image = "/og.png",
  type = "website",
  publishedTime,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const showNotes = (await getNotes()).length > 0;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Blog`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#eef3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1a0f" media="(prefers-color-scheme: dark)" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Apply the saved or system theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        // Motion hooks: set before first paint so nothing flashes. Reduced motion gets neither.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const c = document.documentElement.classList;
          c.add("motion");
          try {
            if (!sessionStorage.getItem("seen")) {
              c.add("intro");
              sessionStorage.setItem("seen", "1");
            }
          } catch {}
        }
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-fg px-4 py-2 text-[16px] text-bg focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>
    <div id="loader" aria-hidden="true">
      <span class="loader-mark font-display inline-flex items-end gap-[0.18em] text-[clamp(2rem,4vw,3.5rem)] font-bold leading-none tracking-[-0.035em]">
        {site.name}<Peaks class="mb-[0.06em] h-[0.82em] w-auto" />
      </span>
    </div>
    <Header showNotes={showNotes} />
    <div id="page" class="flex flex-1 flex-col">
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import "@/scripts/motion";
    </script>
  </body>
</html>
